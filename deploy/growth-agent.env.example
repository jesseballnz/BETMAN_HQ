# Secrets must be installed through host-owned protected configuration.
BETMAN_CORE_URL=https://core.internal.example
BETMAN_HQ_AUTH_SUMMARY_TOKEN=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_ADS_API_VERSION=v20.0

BETMAN_GROWTH_TIME_ZONE=Pacific/Auckland
BETMAN_GROWTH_STATUS=/opt/betman/betman_hq/runtime/growth-agent/latest.json
BETMAN_GROWTH_LEDGER=/opt/betman/betman_hq/runtime/growth-agent/audit.jsonl

# Deterministic safety limits. The worker is dry-run only in this release.
BETMAN_GROWTH_ZERO_LPV_PAUSE_SPEND=20
BETMAN_GROWTH_MIN_LPV_SAMPLE=25
BETMAN_GROWTH_MAX_COST_PER_LPV=0.60
BETMAN_GROWTH_MAX_COST_PER_TRIAL=5
BETMAN_GROWTH_MAX_PAID_CAC=15
BETMAN_GROWTH_MIN_TRIALS_TO_SCALE=10
BETMAN_GROWTH_MIN_PAID_TO_SCALE=3
BETMAN_GROWTH_MAX_BUDGET_CHANGE_PCT=20
