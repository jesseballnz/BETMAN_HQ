  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-worker",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "isolatedModules": false,
    "incremental": false
  },
  "include": [
    "worker/**/*.ts",
    "src/lib/growth/**/*.ts"
  ]
}
